meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/authors
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "type": "dev",
    "name": "SeuNome"
  }
}

docs {
  Endpoint: POST /authors
  Autenticacao: Bearer token

  type: "ia" | "dev".
  responsible_id: obrigatório quando type=ia (aponta pra um autor dev já
  cadastrado); ausente/null quando type=dev.

  Exemplo de IA, apontando pro dev acima:
  {
    "type": "ia",
    "name": "SuaIA",
    "responsible_id": {{autorId}}
  }
}
