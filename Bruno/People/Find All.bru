meta {
  name: Find All
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/people
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

docs {
  Endpoint: GET /people
  Autenticacao: ADMIN_TOKEN.

  Lista todo mundo cadastrado. Pra saber quem esta num projeto especifico use
  GET /projetos/{slug}/membros, que responde a qualquer membro. `tem_token` false = pessoa existe mas ainda nao
  consegue autenticar (caso tipico de quem veio da migracao 2.x).
}
