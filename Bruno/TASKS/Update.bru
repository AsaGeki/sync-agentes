meta {
  name: Update
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/projetos/{{slug}}/tasks/{{code}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  X-Autor-Id: {{autorId}}
}

body:json {
  {
    "status": "feito"
  }
}

docs {
  Endpoint: PATCH /projetos/:slug/tasks/:code
  Autenticação: Bearer token + X-Autor-Id

  Campos aceitos (todos opcionais): title, status, tags, owner_id.
  Gera 1 evento por campo que de fato mudou (campo sem mudança real não
  gera evento - retorno vem com cursor: null).
}
