meta {
  name: Find Diff
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/projetos/{{slug}}/tasks/{{code}}/diff
  body: none
  auth: inherit
}

params:query {
  ~desde: 0
}

docs {
  Endpoint: GET /projetos/:slug/tasks/:code/diff
  Autenticação: Bearer token

  desde: número da versão de referência (default 0). Diff unificado da
  versão "desde" até a mais recente.
}
