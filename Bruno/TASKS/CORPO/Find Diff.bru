meta {
  name: Find Diff
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/projetos/{{slug}}/tasks/{{code}}/diff
  body: none
  auth: inherit
}

params:query {
  ~desde: 0
}

docs {
  Endpoint: GET /projetos/:slug/tasks/:code/diff
  Autenticacao: Bearer token

  desde: numero da versao de referencia (default 0). Diff unificado da
  versao "desde" ate a mais recente.
}
