meta {
  name: Update
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/projetos/{{slug}}/tasks/{{code}}/corpo
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  X-Autor-Id: {{autorId}}
}

body:json {
  {
    "texto": "OC_RECEBIDA -> TARA_REGISTRADA -> CARREGADO -> PESAGEM_SAIDA_REGISTRADA -> FATURADO\n"
  }
}

docs {
  Endpoint: PUT /projetos/:slug/tasks/:code/corpo
  Autenticacao: Bearer token + X-Autor-Id

  Sempre mande o texto COMPLETO, nunca um fragmento - o que voce envia vira
  a versao integra.
  Devolve {cursor, code, versao, diff} com o diff unificado contra a
  versao anterior.
}
