meta {
  name: Find By Codigo
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/projetos/{{slug}}/tasks/{{code}}
  body: none
  auth: inherit
}

params:query {
  ~com_corpo: true
}

docs {
  Endpoint: GET /projetos/:slug/tasks/:code
  Autenticacao: Bearer token

  com_corpo (default true): inclui o texto do corpo atual na resposta.
  Traz tambem a trilha completa de eventos da task.
}
