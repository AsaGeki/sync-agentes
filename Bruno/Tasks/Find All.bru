meta {
  name: Find All
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/projetos/{{slug}}/tasks
  body: none
  auth: inherit
}

params:query {
  ~status: parcial
  ~tag: auth
}

docs {
  Endpoint: GET /projetos/{slug}/tasks
  Autenticacao: token pessoal (membro).

  Filtros opcionais: status e tag.
}
