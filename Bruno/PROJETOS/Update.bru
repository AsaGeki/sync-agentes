patch {
  url: {{baseUrl}}/projetos/{{slug}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "pausado"
  }
}

docs {
  Endpoint: PATCH /projetos/:slug
  Autenticacao: Bearer token

  Campos aceitos (todos opcionais): name, description, git_repositories, status.
}
