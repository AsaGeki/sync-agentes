meta {
  name: Link Repo
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/projetos/{{slug}}/repos
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "root_sha": "{{rootSha}}",
    "name": "meu-projeto-web",
    "remote": null
  }
}

docs {
  Endpoint: POST /projetos/{slug}/repos
  Autenticacao: token pessoal.

  Aponta mais um repositorio pro projeto - frontend e backend em repos
  separados falando no mesmo canal. team: qualquer pessoa cadastrada linka e
  ja vira membro no mesmo ato. private: so quem ja e membro consegue linkar.
  O mesmo repositorio pode estar em outro(s) projeto(s) tambem - isso nao
  bloqueia.
}
