meta {
  name: Update
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/projetos/{{slug}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "description": "Descricao do projeto"
  }
}

docs {
  Endpoint: PATCH /projetos/{slug}
  Autenticacao: token pessoal (membro).

  Campos: name, description, status (ativo|pausado|concluido|arquivado),
  visibility (team|private). So os campos enviados mudam.

  visibility so pode ser mudada por um owner:
  { "visibility": "private" }
}
