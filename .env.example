# Host da API (run.py / src/main.py). 127.0.0.1 = só esta máquina (padrão, seguro).
# 0.0.0.0 = exposto na rede - exige regra de firewall e restringir o IP de quem acessa (ver README).
HOST=127.0.0.1

# Porta da API
PORT=8787

# Token de autenticação (Authorization: Bearer <TOKEN>). Obrigatório - o servidor
# não sobe sem ele. Gere um com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN=
