# Host da API (run.py / src/main.py). 127.0.0.1 = só esta máquina (padrão, seguro).
# 0.0.0.0 = exposto na rede - exige regra de firewall e restringir o IP de quem acessa (ver README).
HOST=127.0.0.1

# Porta da API
PORT=8787

# Token de administração. Só emite e lista pessoa (POST /people, GET /people) -
# não dá acesso ao conteúdo de projeto nenhum. Quem escreve no canal usa o
# próprio token pessoal, emitido por este. Obrigatório: o servidor não sobe sem
# ele. Gere um com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Sincronização com o sistema de destino (telas em /web/admin/sincronizacao e /web/sincronizacao). Opcional.
# URL base do servidor de destino. O token é a credencial de serviço: um token humano de
# administrador do sistema do destino (de preferência de uma conta dedicada à sincronização).
# Ele lê os projetos do destino, importa o que é novo e assina as mudanças de quem sincroniza sem
# token próprio. A interface nunca o mostra. Para emitir e gravar aqui, com DESTINO_URL
# preenchida: node server/scripts/emitir-token-servico.mjs
DESTINO_URL=
DESTINO_TOKEN=
# E-mail da conta dona desse token (o script acima já grava): a tela mostra em nome de quem as mudanças aparecem.
DESTINO_USUARIO_SERVICO=
